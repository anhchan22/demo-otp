APP_NAME=otp-demo
SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/otp_demo?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DRIVER=com.mysql.cj.jdbc.Driver

JPA_DDL_AUTO=validate
JPA_OPEN_IN_VIEW=false
JPA_TIME_ZONE=UTC
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sender@example.com
MAIL_PASSWORD=use-an-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

OTP_HMAC_SECRET=generate-a-long-random-secret
OTP_RATE_LIMIT_WINDOW_SECONDS=600
OTP_MAX_SEND_PER_WINDOW=5
OTP_IP_RATE_LIMIT_WINDOW_SECONDS=600
OTP_IP_RATE_LIMIT_MAX_REQUESTS=20
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DEV_PREVIEW=true

JWT_SECRET=generate-a-separate-long-random-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
FLOW_SECRET=generate-another-separate-long-random-secret
FLOW_TTL_SECONDS=900
COOKIE_SECURE=false

ESMS_ENABLED=false
ESMS_API_URL=https://rest.esms.vn/MainService.svc/json/SendMultipleMessage_V4_post_json/
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRAND_NAME=OTP Demo
ESMS_SANDBOX=true

ZALO_ENABLED=false
ZALO_PROVIDER=esms
ZALO_OA_ID=
ZALO_ACCESS_TOKEN=
ZALO_TEMPLATE_ID=
